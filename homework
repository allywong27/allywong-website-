<!DOCTYPE html>
<html>
<head>
  <title>Homework Help</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(to bottom right, #ffc1e3, #ffffff);
      text-align: center;
      padding: 40px;
    }

    h1 {
      color: #ff69b4;
      font-size: 45px;
    }

    p {
      font-size: 20px;
      color: #555;
    }

    textarea {
      width: 80%;
      height: 150px;
      border-radius: 15px;
      border: 2px solid #ff9fd6;
      padding: 15px;
      font-size: 16px;
    }

    button {
      margin-top: 20px;
      padding: 12px 25px;
      border: none;
      border-radius: 20px;
      background-color: #ff69b4;
      color: white;
      font-size: 18px;
      cursor: pointer;
    }

    a {
      display: block;
      margin-top: 30px;
      color: #ff69b4;
      text-decoration: none;
    }
  </style>
</head>
<body>

  <h1>Homework Help</h1>
  <p>Type your homework question below:</p>

  <textarea placeholder="Paste or type your homework question here..."></textarea>
  <br>
  <button>Get Help</button>

  <a href="school.html">← Back to School Helper</a>

</body>
</html>
